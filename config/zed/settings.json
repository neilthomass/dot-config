// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  // Autosave 1s after you stop typing. Other options: "on_focus_change",
  // "on_window_change", or "off".
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "languages": {
    "C++": {
      "format_on_save": "on",
      "tab_size": 2,
      "show_completions_on_input": true,
      "use_autoclose": true,
    },
  },
  "lsp": {
    "clangd": {
      "arguments": [
        "--clang-tidy",
        "--background-index",
        "--header-insertion=iwyu",
        "--all-scopes-completion",
        "--completion-style=detailed",
        // Let clangd query Homebrew g++ for its real include paths in projects
        // that ship a compile_commands.json built with it. Without a compile DB,
        // the include paths in clangd/config.yaml are what resolve <bits/stdc++.h>.
        "--query-driver=/opt/homebrew/bin/g++-16,/opt/homebrew/bin/gcc-16",
      ],
    },
  },
}
