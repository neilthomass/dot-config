// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // NOTE: ssh_connections is deliberately not tracked here — it holds internal
  // hostnames and this repo is public. Zed will re-add it locally as you connect.
  "session": {
    "trust_all_worktrees": true
  },
  "redact_private_values": true,
  "disable_ai": true,
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "cli_default_open_behavior": "new_window",
  "vim_mode": true,
  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  // Autosave 1s after you stop typing. Other options: "on_focus_change",
  // "on_window_change", or "off".
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "languages": {
    "C++": {
      "format_on_save": "on",
      "tab_size": 2,
      "show_completions_on_input": true,
      "use_autoclose": true,
    },
  },
  "lsp": {
    "clangd": {
      "binary": {
        // Apple clangd 16 cannot parse Homebrew GCC 16's libstdc++ headers.
        // Use Zed's managed current clangd instead.
        "ignore_system_version": true,
        "arguments": [
          "--clang-tidy",
          "--background-index",
          "--header-insertion=iwyu",
          "--all-scopes-completion",
          "--completion-style=detailed",
          "--query-driver=/opt/homebrew/bin/g++-16,/opt/homebrew/bin/gcc-16,/usr/bin/g++",
        ],
      },
    },
  },
}
